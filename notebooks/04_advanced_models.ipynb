    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"04 — Advanced Machine Learning Models\\n\",\n",
    "    \"\\n\",\n",
    "    \"Goal: Evaluate whether more advanced models improve temperature forecasting accuracy.\\n\",\n",
    "    \"\\n\",\n",
    "    \"We implement:\\n\",\n",
    "    \"1) Ridge Regression\\n\",\n",
    "    \"2) Lasso Regression\\n\",\n",
    "    \"3) Random Forest\\n\",\n",
    "    \"4) Gradient Boosting\\n\",\n",
    "    \"\\n\",\n",
    "    \"Evaluation metric: RMSE\\n\",\n",
    "    \"Validation strategy: chronological split (no data leakage)\"\n",
    "   ],\n",
    "   \"id\": \"877693020683aa41\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.069459Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:56.699281200Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"from sklearn.linear_model import Ridge, Lasso\\n\",\n",
    "    \"from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\\n\",\n",
    "    \"from sklearn.metrics import mean_squared_error\\n\",\n",
    "    \"\\n\",\n",
    "    \"sns.set_style(\\\"whitegrid\\\")\\n\",\n",
    "    \"plt.rcParams.update({\\n\",\n",
    "    \"    \\\"font.family\\\": \\\"Times New Roman\\\",\\n\",\n",
    "    \"    \\\"font.size\\\": 11,\\n\",\n",
    "    \"    \\\"axes.titlesize\\\": 14,\\n\",\n",
    "    \"    \\\"axes.titleweight\\\": \\\"bold\\\",\\n\",\n",
    "    \"    \\\"axes.labelsize\\\": 12,\\n\",\n",
    "    \"    \\\"axes.labelweight\\\": \\\"bold\\\",\\n\",\n",
    "    \"    \\\"legend.fontsize\\\": 10,\\n\",\n",
    "    \"})\"\n",
    "   ],\n",
    "   \"id\": \"467f28ed2b021d6\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.081362200Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:57.070960700Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"df = pd.read_csv(\\\"../data/processed/winter_2021_2026.csv\\\")\\n\",\n",
    "    \"df[\\\"date\\\"] = pd.to_datetime(df[\\\"date\\\"])\\n\",\n",
    "    \"df = df.sort_values(\\\"date\\\")\\n\",\n",
    "    \"df = df.set_index(\\\"date\\\")\"\n",
    "   ],\n",
    "   \"id\": \"bdcf3cbdc5654125\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.105056300Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:57.086362Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"df_model = df.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Ensure numeric\\n\",\n",
    "    \"df_model[\\\"tavg\\\"] = pd.to_numeric(df_model[\\\"tavg\\\"], errors=\\\"coerce\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Lag features\\n\",\n",
    "    \"for lag in range(1, 8):\\n\",\n",
    "    \"    df_model[f\\\"lag_{lag}\\\"] = df_model[\\\"tavg\\\"].shift(lag)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Rolling statistics (shifted)\\n\",\n",
    "    \"df_model[\\\"rolling_mean_3\\\"] = df_model[\\\"tavg\\\"].rolling(3).mean().shift(1)\\n\",\n",
    "    \"df_model[\\\"rolling_mean_7\\\"] = df_model[\\\"tavg\\\"].rolling(7).mean().shift(1)\\n\",\n",
    "    \"df_model[\\\"rolling_std_7\\\"] = df_model[\\\"tavg\\\"].rolling(7).std().shift(1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Keep only necessary columns\\n\",\n",
    "    \"features = [col for col in df_model.columns if col.startswith(\\\"lag_\\\") or col.startswith(\\\"rolling\\\")]\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_model = df_model[[\\\"tavg\\\"] + features].dropna().copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Rows after cleaning:\\\", len(df_model))\"\n",
    "   ],\n",
    "   \"id\": \"fe5d86e68dc15e3a\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Rows after cleaning: 345\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.118593Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:57.113056700Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"train = df_model.iloc[:-90]\\n\",\n",
    "    \"test = df_model.iloc[-90:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train = train[features]\\n\",\n",
    "    \"y_train = train[\\\"tavg\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_test = test[features]\\n\",\n",
    "    \"y_test = test[\\\"tavg\\\"]\"\n",
    "   ],\n",
    "   \"id\": \"102d34292d6217ee\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.537397800Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:57.120092700Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"models = {\\n\",\n",
    "    \"    \\\"Ridge\\\": Ridge(alpha=1.0),\\n\",\n",
    "    \"    \\\"Lasso\\\": Lasso(alpha=0.01),\\n\",\n",
    "    \"    \\\"Random Forest\\\": RandomForestRegressor(\\n\",\n",
    "    \"        n_estimators=300,\\n\",\n",
    "    \"        random_state=42\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    \\\"Gradient Boosting\\\": GradientBoostingRegressor(\\n\",\n",
    "    \"        n_estimators=300,\\n\",\n",
    "    \"        learning_rate=0.05,\\n\",\n",
    "    \"        random_state=42\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"results = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, model in models.items():\\n\",\n",
    "    \"    model.fit(X_train, y_train)\\n\",\n",
    "    \"    y_pred = model.predict(X_test)\\n\",\n",
    "    \"    rmse = np.sqrt(mean_squared_error(y_test, y_pred))\\n\",\n",
    "    \"    results[name] = rmse\"\n",
    "   ],\n",
    "   \"id\": \"9f05b013dcbd6d4f\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.553122300Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:57.538398100Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"results_df = pd.DataFrame({\\n\",\n",
    "    \"    \\\"Model\\\": list(results.keys()),\\n\",\n",
    "    \"    \\\"RMSE\\\": list(results.values())\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_df.sort_values(\\\"RMSE\\\")\"\n",
    "   ],\n",
    "   \"id\": \"f23911a35c05688\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"               Model      RMSE\\n\",\n",
