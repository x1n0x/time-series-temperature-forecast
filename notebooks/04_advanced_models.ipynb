    "       \"  </tbody>\\n\",\n",
    "       \"</table>\\n\",\n",
    "       \"</div>\"\n",
    "      ]\n",
    "     },\n",
    "     \"execution_count\": 6,\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"execute_result\"\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-16T15:41:57.678039800Z\",\n",
    "     \"start_time\": \"2026-02-16T15:41:57.575575200Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"plt.figure(figsize=(8,4))\\n\",\n",
    "    \"sns.barplot(data=results_df, x=\\\"Model\\\", y=\\\"RMSE\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.title(\\\"Advanced Model Comparison (RMSE)\\\")\\n\",\n",
    "    \"plt.xticks(rotation=30)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"dfa3f3d6267401e5\",\n",
